<!DOCTYPE html>
<html lang="{{ str_replace('_', '-', app()->getLocale()) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ $title }}</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@200;600&family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <!-- Styles -->
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            color: #fff;
            height: 100vh;
            overflow: hidden;
            background: linear-gradient(135deg, #1f3a6d, #3f7bbf);
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            text-align: center;
        }

        .content {
            z-index: 10;
            animation: fadeIn 2s ease-out;
        }

        /* Title */
        .title {
            font-size: 4.5rem;
            font-weight: 700;
            margin-bottom: 20px;
            text-shadow: 0 4px 12px rgba(0, 0, 0, 0.4);
            letter-spacing: 2px;
        }

        /* Sub-title */
        .sub-title {
            font-size: 1.8rem;
            margin-bottom: 40px;
            font-weight: 300;
            opacity: 0.9;
        }

        /* Navigation links */
        .links {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 30px;
        }

        .links > a {
            color: #fff;
            font-size: 1.2rem;
            font-weight: 600;
            text-decoration: none;
            background-color: transparent;
            border: 2px solid #fff;
            border-radius: 50px;
            padding: 15px 40px;
            transition: all 0.4s ease;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
        }

        .links > a:hover {
            background-color: #fff;
            color: #3498db;
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

        /* Background Image Parallax */
        .parallax {
            background-image: url('https://images.unsplash.com/photo-1601463414843-6e47ee8e3f7c?crop=entropy&cs=tinysrgb&fit=max&ixid=MnwzNjUyOXwwfDF8c2VhY2h8MXx8bW9uZXklMjBzaG9wfGVufDB8fHx8fDE2NzkxMTQzMjY&ixlib=rb-1.2.1&q=80&w=1080');
            background-position: center;
            background-size: cover;
            background-attachment: fixed;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            filter: blur(5px);
            opacity: 0.7;
        }

        /* Animation for fade-in */
        @keyframes fadeIn {
            0% {
                opacity: 0;
                transform: translateY(50px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Button Styles */
        .cta-button {
            padding: 18px 40px;
            background-color: #e74c3c;
            color: white;
            font-size: 1.4rem;
            font-weight: 700;
            border-radius: 50px;
            text-decoration: none;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
            transition: all 0.4s ease;
            margin-top: 40px;
        }

        .cta-button:hover {
            background-color: #c0392b;
            transform: translateY(-7px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        }

    </style>
</head>
<body>
    <div class="parallax"></div>

    <div class="content">
        <div class="title">{{ $title }}</div>
        <div class="sub-title">Explore the most exclusive offers and products!</div>

        <div class="links">
            <a href="{{ url('/') }}">Welcome</a>
            <a href="{{ url('/home') }}">Dashboard</a>
            <a href="{{ url('/login') }}">Login</a>
        </div>

        
    </div>

</body>
</html>
